{
  "name": "loom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node --import tsx server/main.ts",
    "init": "node --import tsx server/cli.ts init",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "build": "pnpm run check && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/main.js",
    "backup": "node dist/server/server/cli.js backup",
    "restore": "node dist/server/server/cli.js restore",
    "test:e2e": "playwright test",
    "format": "prettier --write server shared web tests e2e *.json *.ts index.html"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.0.0",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "packageManager": "pnpm@12.4.1"
}
